<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_radar_preview_background">

    <ImageView
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_radar_preview"
        android:tint="#90BFD9EC" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:text="@string/widget_radar_animated"
        android:textColor="#F5FAFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:drawableStart="@drawable/widget_radar_preview"
        android:drawablePadding="8dp"
        android:drawableTint="#BDEADD"
        android:gravity="center_vertical"
        android:text="@string/widget_radar_play"
        android:textColor="#BDEADD"
        android:textSize="14sp" />
</FrameLayout>
